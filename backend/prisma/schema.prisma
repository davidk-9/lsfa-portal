generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model User {
  id                      Int             @id @default(autoincrement())
  email                   String          @unique
  name                    String
  passwordHash            String
  role                    Role            @default(TRAINER)
  isActive                Boolean         @default(true)
  mfaCode                 String?
  mfaExpiresAt            DateTime?
  resetPasswordToken      String?
  resetPasswordExpiresAt  DateTime?
  magicToken              String?         @unique
  axcelerateContactId     String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  createdById             Int?
  contactId               Int?            @unique
  contact                 Contact?        @relation(fields: [contactId], references: [id])
  createdBy               User?           @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers            User[]          @relation("CreatedUsers")
  trustedDevices          TrustedDevice[]
}

model TrustedDevice {
  id        Int      @id @default(autoincrement())
  userId    Int
  deviceKey String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CourseCode {
  id                 Int                    @id @default(autoincrement())
  code               String                 @unique
  name               String                 @default("")
  shortName          String                 @default("")
  cost               Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  learningPlans      LearningPlan[]
  chapters           LmsChapter[]
  knowledgeEvidences LmsKnowledgeEvidence[]
}

model WorkshopProgress {
  id               Int             @id @default(autoincrement())
  instanceId       Int             @unique
  trainerContactId String          @default("")
  completedSteps   Int             @default(0)
  totalSteps       Int             @default(3)
  isComplete       Boolean         @default(false)
  statusPayload    String?
  lmsEnabled       Boolean         @default(false)
  learningPlanId   Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  learningPlan     LearningPlan?   @relation(fields: [learningPlanId], references: [id], onDelete: SetNull)
  lmsEnrollments   LmsEnrollment[]

  @@index([isComplete])
  @@index([trainerContactId])
}

model StudentChecklist {
  id         Int      @id @default(autoincrement())
  instanceId Int
  contactId  Int
  courseCode String   @default("")
  data       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, contactId])
  @@index([instanceId])
}

model WorkshopSnapshot {
  id                Int      @id @default(autoincrement())
  instanceId        Int
  courseCode        String
  snapshotData      String
  createdAt         DateTime @default(now())
  masterFingerprint String?
  updatedAt         DateTime @updatedAt

  @@unique([instanceId, courseCode])
}

model WorkshopUpload {
  id                    Int      @id @default(autoincrement())
  instanceId            Int
  contactId             Int?
  portfolioTypeId       Int?
  blobPath              String   @default("")
  blobUrl               String   @default("")
  kind                  String   @default("")
  filename              String   @default("")
  mimeType              String   @default("")
  status                String   @default("active")
  proxyKey              String?  @unique
  axceleratePortfolioId Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  wpProxyKey            String?

  @@index([instanceId])
  @@index([instanceId, contactId])
}

model BulkSchedulerSchedule {
  id        Int                         @id @default(autoincrement())
  name      String
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  runs      BulkSchedulerRun[]
  items     BulkSchedulerScheduleItem[]
}

model BulkSchedulerScheduleItem {
  id              Int                   @id @default(autoincrement())
  scheduleId      Int
  dayOfWeek       Int
  locationId      String?
  locationName    String?
  startTime       String
  endTime         String
  maxParticipants Int                   @default(0)
  courseCode      String
  trainerId       String?
  trainerName     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  schedule        BulkSchedulerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([dayOfWeek])
}

model BulkSchedulerRun {
  id            Int                   @id @default(autoincrement())
  scheduleId    Int
  startDate     String
  endDate       String
  status        String                @default("queued")
  totalExpected Int                   @default(0)
  createdCount  Int                   @default(0)
  errorCount    Int                   @default(0)
  message       String                @default("")
  createdBy     String                @default("")
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  schedule      BulkSchedulerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([status])
}

model Contact {
  id                                     Int      @id @default(autoincrement())
  contactId                              Int      @unique
  givenName                              String?
  title                                  String?
  middleName                             String?
  preferredName                          String?
  surname                                String?
  emailAddress                           String?
  emailAddressAlternative                String?
  sex                                    String?
  dob                                    String?
  historicClientId                       String?
  optionalId                             String?
  usi                                    String?
  usiVerified                            Boolean?
  usiExemption                           Boolean?
  vsn                                    String?
  lui                                    String?
  workReadyParticipantNumber             String?
  saceStudentId                          String?
  position                               String?
  section                                String?
  division                               String?
  organisation                           String?
  orgId                                  Int?
  orgIds                                 String[] @default([])
  buildingName                           String?
  unitNo                                 String?
  streetNo                               String?
  streetName                             String?
  poBox                                  String?
  address1                               String?
  address2                               String?
  city                                   String?
  state                                  String?
  postcode                               String?
  countryId                              Int?
  country                                String?
  sBuildingName                          String?
  sUnitNo                                String?
  sStreetNo                              String?
  sStreetName                            String?
  sPoBox                                 String?
  sAddress1                              String?
  sAddress2                              String?
  sCity                                  String?
  sState                                 String?
  sPostcode                              String?
  sCountryId                             Int?
  sCountry                               String?
  phone                                  String?
  mobilePhone                            String?
  workPhone                              String?
  fax                                    String?
  sourceCodeId                           Int?
  source                                 String?
  comment                                String?
  website                                String?
  citizenStatusId                        Int?
  citizenStatusName                      String?
  fkResidencyStatusId                    Int?
  fkResidencyStatusName                  String?
  countryOfBirthId                       Int?
  countryOfBirthName                     String?
  cityOfBirth                            String?
  countryOfCitizenId                     Int?
  countryOfCitizenName                   String?
  indigenousStatusId                     Int?
  indigenousStatusName                   String?
  mainLanguageId                         Int?
  mainLanguageName                       String?
  englishProficiencyId                   Int?
  englishAssistanceFlag                  Boolean?
  highestSchoolLevelId                   Int?
  highestSchoolLevelYear                 String?
  currentSchoolLevel                     Int?
  atSchoolFlag                           Boolean?
  atSchoolName                           String?
  priorEducationIds                      String[] @default([])
  priorEducationNames                    String[] @default([])
  priorEducationStatus                   Boolean?
  disabilityFlag                         Boolean?
  disabilityTypeIds                      String[] @default([])
  disabilityTypeNames                    String[] @default([])
  labourForceId                          Int?
  labourForceName                        String?
  anzscoCode                             String?
  anzsicCode                             String?
  ielts                                  String?
  surveyContactStatusCode                String?
  emergencyContact                       String?
  emergencyContactRelation               String?
  emergencyContactPhone                  String?
  employerContactId                      Int?
  payerContactId                         Int?
  supervisorContactId                    Int?
  coachContactId                         Int?
  agentContactId                         Int?
  contactRoleId                          Int?
  yearOfArrivalAus                       String?
  customFieldAdditionalSupport           String?
  customFieldAdditionalSupportRequired   String?
  customFieldParentGuardianContactNumber String?
  customFieldEmployer                    String?
  customFieldJobTitle                    String?
  customFieldCJobTitle                   String?
  customFieldCombinedDeclaration         String?
  customFieldDeclarations                String[] @default([])
  customFieldParentGuardianEmail         String?
  customFieldCanPerformCpr2Mins          String?
  customFieldPrecourseWork               String?
  customFieldMarketingPermission         String?
  customFieldParentGuardianFullName      String?
  customFieldUsiPermission               String?
  customFieldPreviousJobTitles           String[] @default([])
  customFieldPreviousJobTitlesOther      String?
  customFieldPreviousCerts               String[] @default([])
  customFieldParentGuardianRelationship  String?
  customFieldWellbeingRequirements       String?
  customFieldULsfaLink                   String?
  lastUpdated                            String?
  contactEntryDate                       String?
  contactActive                          Boolean? @default(true)
  bypassOnboarding                       Boolean  @default(false)
  photo                                  String?
  createdAt                              DateTime @default(now())
  updatedAt                              DateTime @updatedAt
  fullAddress                            String?
  sFullAddress                           String?
  studyReasonId                          String?
  user                                   User?
  lmsEnrollments                         LmsEnrollment[]

  @@index([emailAddress])
  @@index([givenName, surname])
  @@index([mobilePhone])
  @@index([usi])
}

model GNAFAddress {
  id               Int     @id @default(autoincrement())
  addressDetailPid String  @unique
  addressLabel     String
  streetName       String?
  streetType       String?
  localityName     String?
  state            String?
  postcode         String?
  longitude        Float?
  latitude         Float?
  buildingName     String?
  flatNumber       String?
  flatType         String?
  numberFirst      String?
  numberLast       String?
  addressSiteName  String?
  aliasPrincipal   String?
  dateCreated      String?
  geocodeType      String?
  legalParcelId    String?
  levelNumber      String?
  levelType        String?
  lotNumber        String?
  mbCode           String?
  primaryPid       String?
  primarySecondary String?
  principalPid     String?
  streetSuffix     String?

  @@index([addressLabel(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([postcode])
  @@index([state])
}

enum Role {
  SUPER_USER
  ADMIN
  TRAINER
  STUDENT
}

model LearningPlan {
  id               Int                    @id @default(autoincrement())
  courseCodeId     Int
  version          String                 // e.g., "v1.0"
  title            String                 @default("")
  description      String                 @default("")
  status           String                 @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isDefault        Boolean                @default(false)
  effectiveFrom    DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  courseCode       CourseCode             @relation(fields: [courseCodeId], references: [id], onDelete: Cascade)
  planQuestions    LearningPlanQuestion[]
  workshopProgress WorkshopProgress[]
  lmsEnrollments   LmsEnrollment[]

  @@unique([courseCodeId, version])
  @@index([courseCodeId])
}

model LmsKnowledgeEvidence {
  id          String            @id @default(uuid())
  code        String            // e.g., "KE01"
  title       String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  courseCodes CourseCode[]
  blobs       LmsLearningBlob[]
  questions   LmsQuestion[]

  @@index([code])
}

model LmsChapter {
  id           String            @id @default(uuid())
  courseCodeId Int
  title        String
  description  String?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  courseCode   CourseCode        @relation(fields: [courseCodeId], references: [id], onDelete: Cascade)
  blobs        LmsLearningBlob[]

  @@index([courseCodeId, sortOrder])
}

model LmsQuestion {
  id                    String                 @id @default(uuid())
  type                  Int                    // QuestionType enum (1-7)
  questionText          String
  questionData          Json?                  @db.JsonB
  correctAnswer         Json?                  @db.JsonB
  benchmarkAnswer       String?                // For AI / vector grading against model answer
  points                Int                    @default(1)
  coreLearningBlobId    String?
  supportLearningBlobId String?
  knowledgeEvidenceId   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  coreLearningBlob      LmsLearningBlob?       @relation("CoreBlobQuestions", fields: [coreLearningBlobId], references: [id], onDelete: SetNull)
  supportLearningBlob   LmsLearningBlob?       @relation("SupportBlobQuestions", fields: [supportLearningBlobId], references: [id], onDelete: SetNull)
  knowledgeEvidence     LmsKnowledgeEvidence? @relation(fields: [knowledgeEvidenceId], references: [id], onDelete: SetNull)
  planQuestions         LearningPlanQuestion[]

  @@index([type])
  @@index([knowledgeEvidenceId])
}

model LmsLearningBlob {
  id                  String                @id @default(uuid())
  chapterId           String?
  knowledgeEvidenceId String?
  title               String
  description         String?
  contentHtml         String?
  vimeoId             String?
  azureBlobUrl        String?
  durationSeconds     Int                   @default(0)
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  chapter             LmsChapter?           @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  knowledgeEvidence   LmsKnowledgeEvidence? @relation(fields: [knowledgeEvidenceId], references: [id], onDelete: SetNull)
  coreQuestions       LmsQuestion[]         @relation("CoreBlobQuestions")
  supportQuestions    LmsQuestion[]         @relation("SupportBlobQuestions")

  @@index([chapterId, sortOrder])
  @@index([knowledgeEvidenceId])
}

model LearningPlanQuestion {
  learningPlanId Int
  questionId     String
  sortOrder      Int          @default(0)
  points         Int?
  addedAt        DateTime     @default(now())
  learningPlan   LearningPlan @relation(fields: [learningPlanId], references: [id], onDelete: Cascade)
  question       LmsQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([learningPlanId, questionId])
  @@index([learningPlanId, sortOrder])
}

model LmsEnrollment {
  id               String            @id @default(uuid())
  contactId        Int
  instanceId       Int?
  learningPlanId   Int?
  courseCodeStr    String?
  axStatus         String?
  learningMode     Int               @default(3) // DeepDive default
  enrolledAt       DateTime          @default(now())
  completedAt      DateTime?
  isActive         Boolean           @default(true)
  progressData     Json              @default("{}") @db.JsonB
  currentScore     Int               @default(0)
  possibleScore    Int               @default(0)
  isCompetent      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  learningPlan     LearningPlan?     @relation(fields: [learningPlanId], references: [id], onDelete: SetNull)
  workshopProgress WorkshopProgress? @relation(fields: [instanceId], references: [instanceId], onDelete: SetNull)

  @@index([contactId])
  @@index([learningPlanId])
  @@index([instanceId])
}
