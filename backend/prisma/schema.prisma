generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Role {
  SUPER_USER
  ADMIN
  TRAINER
  STUDENT
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(TRAINER)
  isActive      Boolean   @default(true)

  // MFA
  mfaCode       String?
  mfaExpiresAt  DateTime?

  // Axcelerate link (for trainers)
  axcelerateContactId String?

  // Local Contact link
  contactId     Int?      @unique
  contact       Contact?  @relation(fields: [contactId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdById   Int?
  createdBy     User?     @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers  User[]    @relation("CreatedUsers")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CourseCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String   @default("")
  shortName String   @default("")
  cost      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkshopProgress {
  id               Int      @id @default(autoincrement())
  instanceId       Int      @unique
  trainerContactId String   @default("")
  completedSteps   Int      @default(0)
  totalSteps       Int      @default(3)
  isComplete       Boolean  @default(false)
  statusPayload    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isComplete])
  @@index([trainerContactId])
}

model StudentChecklist {
  id         Int      @id @default(autoincrement())
  instanceId Int
  contactId  Int
  courseCode String   @default("")
  data       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, contactId])
  @@index([instanceId])
}

model WorkshopSnapshot {
  id                Int      @id @default(autoincrement())
  instanceId        Int
  courseCode        String
  snapshotData      String
  masterFingerprint String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([instanceId, courseCode])
}

model WorkshopUpload {
  id              Int      @id @default(autoincrement())
  instanceId      Int
  contactId       Int?
  portfolioTypeId Int?
  blobPath        String   @default("")
  blobUrl         String   @default("")
  kind            String   @default("")
  filename        String   @default("")
  mimeType        String   @default("")
  status          String   @default("active")
  proxyKey        String?  @unique
  wpProxyKey      String?
  axceleratePortfolioId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([instanceId])
  @@index([instanceId, contactId])
}

model BulkSchedulerSchedule {
  id        Int                      @id @default(autoincrement())
  name      String
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  items     BulkSchedulerScheduleItem[]
  runs      BulkSchedulerRun[]
}

model BulkSchedulerScheduleItem {
  id              Int                     @id @default(autoincrement())
  scheduleId      Int
  schedule        BulkSchedulerSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  locationId      String?
  locationName    String?
  startTime       String
  endTime         String
  maxParticipants Int                    @default(0)
  courseCode      String
  trainerId       String?
  trainerName     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([scheduleId])
  @@index([dayOfWeek])
}

model BulkSchedulerRun {
  id            Int                     @id @default(autoincrement())
  scheduleId    Int
  schedule      BulkSchedulerSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  startDate     String
  endDate       String
  status        String                  @default("queued")
  totalExpected Int                     @default(0)
  createdCount  Int                     @default(0)
  errorCount    Int                     @default(0)
  message       String                  @default("")
  createdBy     String                  @default("")
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([scheduleId])
  @@index([status])
}

model Contact {
  id                               Int      @id @default(autoincrement())
  contactId                        Int      @unique
  user                             User?

  givenName                        String?
  title                            String?
  middleName                       String?
  preferredName                    String?
  surname                          String?
  emailAddress                     String?
  emailAddressAlternative          String?
  sex                              String?
  dob                              String?

  historicClientId                 String?
  optionalId                       String?
  usi                              String?
  usiVerified                      Boolean?
  usiExemption                     Boolean?
  vsn                              String?
  lui                              String?
  workReadyParticipantNumber       String?
  saceStudentId                    String?

  position                         String?
  section                          String?
  division                         String?
  organisation                     String?
  orgId                            Int?
  orgIds                           String[] @default([])

  buildingName                     String?
  unitNo                           String?
  streetNo                         String?
  streetName                       String?
  poBox                            String?
  address1                         String?
  address2                         String?
  city                             String?
  state                            String?
  postcode                         String?
  countryId                        Int?
  country                          String?

  sBuildingName                    String?
  sUnitNo                          String?
  sStreetNo                        String?
  sStreetName                      String?
  sPoBox                           String?
  sAddress1                        String?
  sAddress2                        String?
  sCity                            String?
  sState                           String?
  sPostcode                        String?
  sCountryId                       Int?
  sCountry                         String?

  phone                            String?
  mobilePhone                      String?
  workPhone                        String?
  fax                              String?
  sourceCodeId                     Int?
  source                           String?
  comment                          String?
  website                          String?

  citizenStatusId                  Int?
  citizenStatusName                String?
  fkResidencyStatusId              Int?
  fkResidencyStatusName            String?
  countryOfBirthId                 Int?
  countryOfBirthName               String?
  cityOfBirth                      String?
  countryOfCitizenId               Int?
  countryOfCitizenName             String?

  indigenousStatusId               Int?
  indigenousStatusName             String?
  mainLanguageId                   Int?
  mainLanguageName                 String?
  englishProficiencyId             Int?
  englishAssistanceFlag            Boolean?

  highestSchoolLevelId             Int?
  highestSchoolLevelYear           String?
  currentSchoolLevel               Int?
  atSchoolFlag                     Boolean?
  atSchoolName                     String?

  priorEducationIds                String[] @default([])
  priorEducationNames              String[] @default([])
  priorEducationStatus             Boolean?

  disabilityFlag                   Boolean?
  disabilityTypeIds                String[] @default([])
  disabilityTypeNames              String[] @default([])

  labourForceId                    Int?
  labourForceName                  String?
  anzscoCode                       String?
  anzsicCode                       String?
  ielts                            String?
  surveyContactStatusCode          String?

  emergencyContact                 String?
  emergencyContactRelation         String?
  emergencyContactPhone            String?

  employerContactId                Int?
  payerContactId                   Int?
  supervisorContactId              Int?
  coachContactId                   Int?
  agentContactId                   Int?
  contactRoleId                    Int?

  yearOfArrivalAus                 String?

  customFieldAdditionalSupport           String?
  customFieldAdditionalSupportRequired   String?
  customFieldParentGuardianContactNumber String?
  customFieldEmployer                    String?
  customFieldJobTitle                    String?
  customFieldCJobTitle                   String?
  customFieldCombinedDeclaration         String?
  customFieldDeclarations                String[] @default([])
  customFieldParentGuardianEmail         String?
  customFieldCanPerformCpr2Mins          String?
  customFieldPrecourseWork               String?
  customFieldMarketingPermission         String?
  customFieldParentGuardianFullName      String?
  customFieldUsiPermission               String?
  customFieldPreviousJobTitles           String[] @default([])
  customFieldPreviousJobTitlesOther      String?
  customFieldPreviousCerts               String[] @default([])
  customFieldParentGuardianRelationship  String?
  customFieldWellbeingRequirements       String?

  lastUpdated                      String?
  contactEntryDate                 String?
  contactActive                    Boolean? @default(true)
  photo                            String?

  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@index([emailAddress])
  @@index([surname, givenName])
}

model GNAFAddress {
  id               Int      @id @default(autoincrement())
  addressDetailPid String   @unique // ADDRESS_DETAIL_PID
  addressLabel     String   // ADDRESS_LABEL
  streetName       String?  // STREET_NAME
  streetType       String?  // STREET_TYPE
  localityName     String?  // LOCALITY_NAME
  state            String?  // STATE
  postcode         String?  // POSTCODE
  longitude        Float?   // LONGITUDE
  latitude         Float?   // LATITUDE

  @@index([addressLabel(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([postcode])
  @@index([state])
}
